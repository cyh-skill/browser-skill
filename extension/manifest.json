{
  "manifest_version": 3,
  "name": "browser-skill bridge",
  "version": "1.4.0",
  "description": "把 Agent 的命令桥接到本地浏览器：chrome.debugger 驱动、托管标签权限、借用归还与彩色会话隔离。",
  "permissions": ["debugger", "tabs", "tabGroups", "alarms", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
