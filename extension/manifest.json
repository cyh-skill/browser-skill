{
  "manifest_version": 3,
  "name": "browser-skill bridge",
  "version": "2.1.0",
  "description": "Rust browser-skill 的扩展 Provider：Agent Window、借用确认、浏览器自动化与历史标签组手动清理。",
  "permissions": ["debugger", "tabs", "tabGroups", "windows", "alarms", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "browser-skill · 清理标签组",
    "default_popup": "popup.html"
  }
}
