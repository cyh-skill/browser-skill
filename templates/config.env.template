# cyh-browser-skill Rust Runtime local configuration.
# Install copies this file to ~/.browser-skill/config.env when absent.

# chrome / chrome-canary / chromium / edge
# BROWSER_SKILL_BROWSER=chrome

# Optional explicit browser endpoint, for example http://127.0.0.1:9222 or ws://...
# BROWSER_SKILL_CDP_ENDPOINT=http://127.0.0.1:9222

# External local or Git knowledge repository.
# BROWSER_SKILL_KNOWLEDGE_DIR=/absolute/path/to/browser-skill-knowledge

# BROWSER_SKILL_HTTP_PORT=3456
# BROWSER_SKILL_EXTENSION_PORT=3458
